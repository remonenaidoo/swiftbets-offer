{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "FaultInjection": {
    "Enabled": false
  },
  "Kafka": {
    "BootstrapServers": "",
    "Environment": "dev",
    "ClientId": "swiftbets-offer"
  },
  "Jwt": {
    "Authority": "",
    "Audience": "swiftbets",
    "RequireHttpsMetadata": true
  },
  "Replay": {
    "SlotSeconds": 10,
    "ListLeadSlots": 30,
    "TickSeconds": 2
  }
}
